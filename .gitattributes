# Keep generated RTL byte-stable across Windows and Linux checkouts.
*.v      text eol=lf
*.sv     text eol=lf
*.vhd    text eol=lf
*.vhdl   text eol=lf
*.scala  text eol=lf
*.sbt    text eol=lf
*.sc     text eol=lf
*.tcl    text eol=lf
*.xdc    text eol=lf
*.xci    text eol=lf
*.md     text eol=lf
*.csv    text eol=lf
*.rpt    -text
*.ps1    text eol=crlf
*.cmd    text eol=crlf
